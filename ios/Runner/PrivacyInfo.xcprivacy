<?xml version="1.0" encoding="UTF-8"?>
<!--
  SoquShield — App Privacy Manifest (Apple privacy manifest, required for App Store upload).

  The company's privacy determination of 2026-10-08: no tracking, no collected data types,
  the UserDefaults reason. The App Privacy answers in App Store Connect are kept consistent
  with this file. The June code audit that drafted the values is the basis below.

  Audit basis:
    • No analytics / tracking / crash SDK is present (no Firebase/Sentry/Amplitude/etc.) →
      NSPrivacyTracking = false, no tracking domains.
    • No sign-in of any kind since 2.2.0: no account, no identifier leaves the device. So no
      first-party collected-data types are declared.
    • Required-reason APIs: the first-party Dart code uses UserDefaults via shared_preferences
      (CA92.1 — access info stored by this app). Plugin pods (path_provider,
      shared_preferences, etc.) ship their OWN PrivacyInfo.xcprivacy and cover their own APIs.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The app does NOT track users (no cross-app/cross-site tracking, no ATT). -->
	<key>NSPrivacyTracking</key>
	<false/>

	<!-- No domains contacted for tracking. -->
	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<!--
	  Data types collected by FIRST-PARTY code and linked to the user / sent off-device.
	  Empty: the app has no account, no sign-in and no analytics; the wallet address and the
	  transactions it signs go to the gateways to answer each request and are not kept as a
	  profile. If a backend ever keeps data linked to a user, the matching entry is added here
	  and in App Store Connect before that build ships.
	-->
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>

	<!--
	  Required-reason API declarations for first-party usage. UserDefaults (CA92.1) covers the
	  Flutter engine + shared_preferences reading/writing this app's own stored values.
	-->
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
