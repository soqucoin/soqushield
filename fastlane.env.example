# SoquShield store-submission credentials — TEMPLATE.
# Copy to ~/.soqushield-release.env (OUTSIDE the repo), fill in, then:
#   set -a; source ~/.soqushield-release.env; set +a
#   cd ios && fastlane beta        # TestFlight
#   cd android && fastlane beta    # Play internal testing
#
# NEVER commit the filled file or the key files. Keep AuthKey .p8 and the
# Play service-account JSON outside the repo (~/.appstoreconnect/, ~/.playstore/).

# --- iOS / App Store Connect API key ---
# App Store Connect → Users & Access → Integrations → API keys → Generate (role: App Manager)
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_PATH=~/.appstoreconnect/AuthKey_XXXXXXXXXX.p8

# --- Android / Play service account ---
# Play Console → API access → service account (grant Release Manager on the app)
PLAY_JSON_KEY_PATH=~/.playstore/soqushield-play-service-account.json
